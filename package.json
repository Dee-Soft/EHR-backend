{
  "name": "ehr-rbac-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prepare": "husky",
    "commit": "cz",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration",
    "test:security": "jest test/security",
    "test:docker": "./scripts/run-tests-docker.sh",
    "test:docker:integration": "docker-compose -f docker-compose.test.yml run --rm test-runner npm run test:integration",
    "test:docker:unit": "docker-compose -f docker-compose.test.yml run --rm test-runner npm run test:unit",
    "test:docker:security": "docker-compose -f docker-compose.test.yml run --rm test-runner npm run test:security",
    "test:local": "./scripts/run-tests-local.sh",
    "test:local:unit": "./scripts/run-tests-local.sh --unit",
    "test:local:integration": "./scripts/run-tests-local.sh --integration",
    "test:local:security": "./scripts/run-tests-local.sh --security",
    "test:local:coverage": "./scripts/run-tests-local.sh --coverage",
    "dev:start": "./scripts/start-dev.sh",
    "dev:check-network": "./scripts/check-network.sh",
    "test:verify-infra": "./scripts/test-simple.sh",
    "docs": "jsdoc -c jsdoc.json",
    "docs:md": "jsdoc2md controllers/**/*.js services/**/*.js middlewares/**/*.js > docs/API.md"
  },
  "author": "Sarfaraj Shahjahan",
  "license": "ISC",
  "description": "EHR backend server using Express.js and MongoDB",
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.10.0",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.3.1",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.0",
    "node-vault": "^0.10.9",
    "validator": "^13.15.15",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@jest/test-sequencer": "^30.2.0",
    "@types/jest": "^30.0.0",
    "better-docs": "^2.7.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jsdoc": "^4.0.5",
    "jsdoc-to-markdown": "^9.1.3",
    "mongodb-memory-server": "^10.4.1",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
