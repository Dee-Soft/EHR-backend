    {
      "name": "RBAC Registration Tests",
      "item": [
        {
          "name": "Employee registers Patient (Allowed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Patient\",\n  \"email\": \"new.patient@test.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"Patient\",\n  \"phone\": \"555-0105\",\n  \"address\": \"101 Test Road\",\n  \"dateOfBirth\": \"1995-05-20\",\n  \"gender\": \"Male\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/register",
              "host": ["{{base_url}}"],
              "path": ["users", "register"]
            },
            "description": "Employee should be able to register new Patients"
          },
          "response": []
        },
        {
          "name": "Employee registers Provider (Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Provider\",\n  \"email\": \"new.provider@test.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"Provider\",\n  \"phone\": \"555-0106\",\n  \"address\": \"202 Test Avenue\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/register",
              "host": ["{{base_url}}"],
              "path": ["users", "register"]
            },
            "description": "Employee should NOT be able to register Providers"
          },
          "response": []
        },
        {
          "name": "Manager registers Employee (Allowed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Employee\",\n  \"email\": \"new.employee@test.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"Employee\",\n  \"phone\": \"555-0107\",\n  \"address\": \"303 Test Lane\",\n  \"employeeId\": \"EMP-002\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/register",
              "host": ["{{base_url}}"],
              "path": ["users", "register"]
            },
            "description": "Manager should be able to register new Employees"
          },
          "response": []
        },
        {
          "name": "Provider registers Patient (Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Another Patient\",\n  \"email\": \"another.patient@test.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"Patient\",\n  \"phone\": \"555-0108\",\n  \"address\": \"404 Test Circle\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/register",
              "host": ["{{base_url}}"],
              "path": ["users", "register"]
            },
            "description": "Provider should NOT be able to register anyone"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Patient Record Tests",
      "item": [
        {
          "name": "Provider creates record for assigned patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": \"{{patient2_id}}\",\n  \"diagnosis\": \"Common cold with mild fever\",\n  \"notes\": \"Patient presented with runny nose, cough, and temperature of 38.2°C. No serious complications observed.\",\n  \"medications\": [\"Paracetamol 500mg every 6 hours\", \"Vitamin C supplements\"],\n  \"visitDate\": \"{{today_date}} {{current_time}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/patient-records",
              "host": ["{{base_url}}"],
              "path": ["patient-records"]
            },
            "description": "Provider creates medical record for assigned patient"
          },
          "response": []
        },
        {
          "name": "Patient tries to create record (Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": \"{{patient_id}}\",\n  \"diagnosis\": \"Self-diagnosed headache\",\n  \"notes\": \"I have a headache\",\n  \"medications\": [\"Aspirin\"],\n  \"visitDate\": \"{{today_date}} {{current_time}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/patient-records",
              "host": ["{{base_url}}"],
              "path": ["patient-records"]
            },
            "description": "Patient should NOT be able to create records"
          },
          "response": []
        },
        {
          "name": "Patient views own records",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/patient-records/my-records",
              "host": ["{{base_url}}"],
              "path": ["patient-records", "my-records"]
            },
            "description": "Patient views their own medical records"
          },
          "response": []
        },
        {
          "name": "Provider views assigned patient records",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/patient-records/provider/assigned",
              "host": ["{{base_url}}"],
              "path": ["patient-records", "provider", "assigned"]
            },
            "description": "Provider views records of all assigned patients"
          },
          "response": []
        },
        {
          "name": "Get specific record by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/patient-records/{{created_record_id}}",
              "host": ["{{base_url}}"],
              "path": ["patient-records", "{{created_record_id}}"]
            },
            "description": "Get specific patient record by ID"
          },
          "response": []
        }
      ]
    },
