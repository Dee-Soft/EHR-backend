  "registration_test_cases": [
    {
      "test_name": "Employee can register Patient",
      "requester_role": "Employee",
      "target_role": "Patient",
      "expected_result": "allowed",
      "status_code": 201,
      "required_fields": ["name", "email", "password", "role", "phone", "address", "dateOfBirth", "gender"],
      "optional_fields": ["assignedProviderId"]
    },
    {
      "test_name": "Employee cannot register Provider",
      "requester_role": "Employee",
      "target_role": "Provider",
      "expected_result": "forbidden",
      "status_code": 403,
      "expected_message": "Not allowed to register this Provider",
      "required_fields": ["name", "email", "password", "role", "providerId"]
    },
    {
      "test_name": "Manager can register Employee",
      "requester_role": "Manager",
      "target_role": "Employee",
      "expected_result": "allowed",
      "status_code": 201,
      "required_fields": ["name", "email", "password", "role", "employeeId"]
    },
    {
      "test_name": "Manager can register Provider",
      "requester_role": "Manager",
      "target_role": "Provider",
      "expected_result": "allowed",
      "status_code": 201,
      "required_fields": ["name", "email", "password", "role", "providerId"]
    },
    {
      "test_name": "Admin can register Manager",
      "requester_role": "Admin",
      "target_role": "Manager",
      "expected_result": "allowed",
      "status_code": 201,
      "required_fields": ["name", "email", "password", "role", "managerId"]
    },
    {
      "test_name": "Admin can register Admin",
      "requester_role": "Admin",
      "target_role": "Admin",
      "expected_result": "allowed",
      "status_code": 201,
      "required_fields": ["name", "email", "password", "role", "adminId"]
    },
    {
      "test_name": "Provider cannot register Patient",
      "requester_role": "Provider",
      "target_role": "Patient",
      "expected_result": "forbidden",
      "status_code": 403
    },
    {
      "test_name": "Patient cannot register anyone",
      "requester_role": "Patient",
      "target_role": "Patient",
      "expected_result": "forbidden",
      "status_code": 403
    }
  ],
  "update_test_cases": [
    {
      "test_name": "Patient can update own phone and address",
      "requester_role": "Patient",
      "target_role": "Patient",
      "is_self": true,
      "allowed_fields": ["phone", "address"],
      "forbidden_fields": ["name", "email", "dateOfBirth", "gender", "assignedProviderId", "employeeId", "providerId", "managerId", "adminId"]
    },
    {
      "test_name": "Employee can update Patient fields",
      "requester_role": "Employee",
      "target_role": "Patient",
      "is_self": false,
      "allowed_fields": ["name", "email", "phone", "address", "dateOfBirth", "gender", "assignedProviderId"],
      "forbidden_fields": ["employeeId", "providerId", "managerId", "adminId"]
    },
    {
      "test_name": "Manager can update Employee",
      "requester_role": "Manager",
      "target_role": "Employee",
      "is_self": false,
      "allowed_fields": ["name", "email", "phone", "address", "employeeId"],
      "forbidden_fields": ["providerId", "managerId", "adminId", "assignedProviderId"]
    },
    {
      "test_name": "Manager can update Provider",
      "requester_role": "Manager",
      "target_role": "Provider",
      "is_self": false,
      "allowed_fields": ["name", "email", "phone", "address", "providerId", "assignedPatients"],
      "forbidden_fields": ["employeeId", "managerId", "adminId", "assignedProviderId"]
    },
    {
      "test_name": "Admin can update Manager",
      "requester_role": "Admin",
      "target_role": "Manager",
      "is_self": false,
      "allowed_fields": ["name", "email", "phone", "address", "managerId"],
      "forbidden_fields": ["employeeId", "providerId", "adminId", "assignedProviderId", "assignedPatients"]
