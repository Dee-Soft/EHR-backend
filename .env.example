# EHR Backend Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# Application Configuration
# ============================================

# Node environment (development, production, test)
NODE_ENV=development

# Server port
PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ============================================
# Database Configuration
# ============================================

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/ehr-system

# ============================================
# OpenBao Keys Management System Configuration
# ============================================

# OpenBao server address
# Use http://localhost:18200 when running EHR backend locally
# Use http://openbao:8200 when running in Docker network
OPENBAO_ADDR=http://localhost:18200

# OpenBao authentication token (fixed token for development)
OPENBAO_TOKEN=ehr-permanent-token

# Transit key names in OpenBao
OPENBAO_TRANSIT_AES_KEY=ehr-aes-master
OPENBAO_TRANSIT_RSA_KEY=ehr-rsa-exchange

# ============================================
# Security Configuration
# ============================================

# JWT secret for token signing
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# Production Configuration (Optional)
# ============================================

# For production, use AppRole authentication instead of fixed token
# OPENBAO_ROLE_ID=your-role-id
# OPENBAO_SECRET_ID=your-secret-id

# ============================================
# Docker Configuration
# ============================================

# When running in Docker, use host.docker.internal to access localhost
# OPENBAO_ADDR=http://host.docker.internal:18200

# ============================================
# Notes
# ============================================

# 1. The OpenBao keys management system must be running separately
# 2. For development, use the fixed token 'ehr-permanent-token'
# 3. For production, implement proper token management
# 4. Ensure network connectivity between EHR backend and OpenBao system
