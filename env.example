# EHR Backend Environment Configuration Template

# Server Configuration
# Application environment: development, production, test
NODE_ENV=development

# Server port
PORT=3001

# MongoDB connection string
MONGO_URI=mongodb://mongodb:27017/ehr

# OpenBao Keys Management System Configuration
OPENBAO_ADDR=http://localhost:18200

# OpenBao authentication token (development token)
OPENBAO_TOKEN=ehr-permanent-token

# OpenBao Transit Engine key names
OPENBAO_TRANSIT_AES_BACKEND_KEY=ehr-aes-master-backend
OPENBAO_TRANSIT_AES_FRONTEND_KEY=ehr-aes-master-frontend
OPENBAO_TRANSIT_RSA_BACKEND_KEY=ehr-rsa-exchange-backend
OPENBAO_TRANSIT_RSA_FRONTEND_KEY=ehr-rsa-exchange-frontend

# OpenBao AppRole authentication (for production)
# OPENBAO_ROLE_ID=role-id
# OPENBAO_SECRET_ID=secret-id

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# Log level: debug, info, warn, error
LOG_LEVEL=info

