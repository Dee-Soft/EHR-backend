# EHR Backend Environment Configuration
# Copy this file to .env and update the values for your environment
# DO NOT commit .env files to version control

# ============================================
# Application Configuration
# ============================================

# Node.js environment (development, production, test)
NODE_ENV=development

# Server port
PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Log level (debug, info, warn, error)
LOG_LEVEL=debug

# ============================================
# Database Configuration
# ============================================

# MongoDB connection string
MONGO_URI=mongodb://mongoDB:27017/EhrDB

# ============================================
# OpenBao Keys Management System Configuration
# ============================================

# OpenBao API address
# When running in Docker with ehr-keys-net network: http://openbao:8200
# When running locally: http://localhost:18200
OPENBAO_ADDR=http://openbao:8200

# OpenBao authentication token
# Default token from EHR Keys Management System setup
OPENBAO_TOKEN=ehr-permanent-token

# Transit engine key names configured in OpenBao
OPENBAO_TRANSIT_AES_KEY=ehr-aes-master
OPENBAO_TRANSIT_RSA_KEY=ehr-rsa-exchange

# AppRole authentication (for production)
# OPENBAO_ROLE_ID=
# OPENBAO_SECRET_ID=

# ============================================
# Security Configuration
# ============================================

# JWT secret for authentication tokens
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change-this-to-a-strong-random-secret

# ============================================
# Rate Limiting Configuration
# ============================================

# API rate limit window (ms)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes

# API rate limit max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Authentication rate limit window (ms)
AUTH_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes

# Authentication rate limit max requests per window
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ============================================
# Audit Logging Configuration
# ============================================

# Enable audit logging (true/false)
AUDIT_LOGGING_ENABLED=true

# Audit log retention days
AUDIT_LOG_RETENTION_DAYS=90

# ============================================
# Cron Job Configuration
# ============================================

# Enable cron jobs (true/false)
CRON_JOBS_ENABLED=true

# Audit log cleanup schedule (cron expression)
AUDIT_LOG_CLEANUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# ============================================
# Development Overrides
# ============================================

# Uncomment for local development without Docker
# MONGO_URI=mongodb://localhost:27017/ehr-system
# OPENBAO_ADDR=http://localhost:18200
