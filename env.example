# EHR Backend Environment Configuration Template
# Copy this file to .env and update the values for your environment

# ============================================
# Server Configuration
# ============================================

# Application environment: development, production, test
NODE_ENV=development

# Server port
PORT=3001

# ============================================
# Database Configuration
# ============================================

# MongoDB connection string
# For Docker development (with docker-compose):
MONGO_URI=mongodb://mongodb:27017/ehr
# For local development (MongoDB running on host):
# MONGO_URI=mongodb://localhost:27017/ehr

# MongoDB connection timeouts (optional)
# MONGO_CONNECT_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=45000

# ============================================
# OpenBao Keys Management System Configuration
# ============================================

# OpenBao API address
# For Docker network (when EHR Keys Management System is running in Docker):
OPENBAO_ADDR=http://openbao:8200
# For local development (OpenBao running on host):
# OPENBAO_ADDR=http://localhost:18200

# OpenBao authentication token (development token)
OPENBAO_TOKEN=ehr-permanent-token

# OpenBao Transit Engine key names
OPENBAO_TRANSIT_AES_KEY=ehr-aes-master
OPENBAO_TRANSIT_RSA_KEY=ehr-rsa-exchange

# OpenBao AppRole authentication (for production)
# OPENBAO_ROLE_ID=your-role-id
# OPENBAO_SECRET_ID=your-secret-id

# ============================================
# Authentication & Security
# ============================================

# JWT signing secret (generate a secure one for production)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-change-this-in-production

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# ============================================
# Logging Configuration
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# Rate Limiting
# ============================================

# API rate limit (requests per 15 minutes per IP)
# Default: 100 for non-test environments, 10000 for tests
# RATE_LIMIT_MAX=100

# Authentication rate limit (login attempts per 15 minutes per IP)
# Default: 5 for non-test environments, 10000 for tests
# AUTH_RATE_LIMIT_MAX=5

# ============================================
# Application Settings
# ============================================

# Backend URL for key exchange (if using separate frontend/backend)
# BACKEND_URL=http://localhost:3001

# ============================================
# Development Notes
# ============================================

# 1. For local development without external OpenBao:
#    - Comment out OPENBAO_ADDR=http://openbao:8200
#    - Uncomment OPENBAO_ADDR=http://localhost:18200
#    - The server will start with a warning about OpenBao connectivity

# 2. To generate a secure JWT_SECRET:
#    openssl rand -base64 32

# 3. For production:
#    - Use strong, unique secrets
#    - Consider using AppRole authentication for OpenBao
#    - Enable TLS for OpenBao communication
#    - Set NODE_ENV=production

# 4. Docker network requirements:
#    - The 'ehr-keys-net' network must exist for Docker-to-Docker communication
#    - Create with: docker network create ehr-keys-net
#    - Or update OPENBAO_ADDR to use localhost
