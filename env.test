# EHR Backend Test Environment Configuration
# Used for running tests in Docker

NODE_ENV=test
PORT=3001
# Match Docker Compose service name: mongodb-test
MONGO_URI=mongodb://mongodb-test:27017/ehr-test
JWT_SECRET=test-jwt-secret-key-for-testing-only
LOG_LEVEL=error

# Test mode - use mock OpenBao (tests mock OpenBao, this URL is not used)
# Using localhost won't work in Docker, but tests mock OpenBao anyway
OPENBAO_ADDR=http://localhost:18200
OPENBAO_TOKEN=test-token
OPENBAO_TRANSIT_AES_KEY=test-aes-key
OPENBAO_TRANSIT_RSA_KEY=test-rsa-key

# Disable rate limiting for tests
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=100

# Disable audit logging for tests
AUDIT_LOGGING_ENABLED=false

# Disable cron jobs for tests
CRON_JOBS_ENABLED=false

# Test optimizations
# Skip OpenBao initialization in test mode (tests mock it)
SKIP_OPENBAO_INIT=true
# Reduce MongoDB connection timeout for faster test failures
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=10000
# Disable mongoose debug mode
MONGOOSE_DEBUG=false
# Skip server listening in test mode
SKIP_SERVER_LISTEN=true
